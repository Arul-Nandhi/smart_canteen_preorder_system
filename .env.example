# Smart Canteen Portal - Environment Variables Template
# Copy this file to .env and fill in the values

# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-key-generate-a-random-50-char-string-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/smartcanteen

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://frontend.yourdomain.com

# Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# AWS S3 Configuration (Optional - for media storage)
USE_S3=False
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# API Settings
API_THROTTLE_RATE_ANON=100/hour
API_THROTTLE_RATE_USER=1000/hour

# Logging
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Feature Flags
ENABLE_REAL_TIME=True
ENABLE_NOTIFICATIONS=True
ENABLE_ANALYTICS=True
